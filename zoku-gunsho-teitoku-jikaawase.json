 "blocks": [
  {
   "id": "zoku-gunsho-teitoku-jikaawase-0001",
   "pid": "nao-733169",
   "pages": [
    1
   ],
   "text": "右君をなとおもふ色にはかへるらんうき世にそさぬすみそめのそて此貞徳自五十番歌合彼翁以自筆本冩之訖尤可為證本者也中秋中三日貞徳翁自歌合一番草花早左ほし合のそらやうらみむはつ秋の香にひとくなゝくさの花右むしも又はたをりそめぬ秋野の老のにしきはたれかいそきし二番旅天雁左人やかの道かとそおもふ時しもあれうき秋かせにわたるよりかね右",
   "poems": [
    "1",
    "2",
    "3",
    "4"
   ]
  },
  {
   "id": "zoku-gunsho-teitoku-jikaawase-0002",
   "pid": "nao-733169",
   "pages": [
    2
   ],
   "text": "故里やなをわすられぬ風さはきむらくもまうふ夜半のなか三番秋枕夢左山鳥のおきの葉そよくなかきよにひとりみしかき手枕の夢右手まくらの露に心や置ぬらんむすひかねたる長き夜の夢四番月宿松左遠山にしはしいさよふ月のうちのかつらのことき峯の松かえ右雲はらぬ嵐をよはのあるしにておのへの松にやさる月影五番寺司左古寺の明のつゝみもなかきよのふるみるや月の類にしるらん右ふるてらにもりいる月の愛もし火はあるゝにつきてかすそそひける六番岡竹月左置ぬ歌をくや岡への竹の葉にそよかぬ月もそよく秋風右",
   "poems": [
    "5",
    "6",
    "7",
    "8",
    "9",
    "10",
    "11",
    "12"
   ]
  },
  {
   "id": "zoku-gunsho-teitoku-jikaawase-0003",
   "pid": "nao-733169",
   "pages": [
    3
   ],
   "text": "かたおかの月そさひし支さと人の夏はすゝみしさゝのゑのはら七番寒庭虫朝日かけさせもか歌をいのちにてかきねの霜に残るむしのね左右こなたかなま虫の鳴ねもかれ残る垣根やをのかたまのをまゝき八番里楼衣左更行は雲ゐに高てなるかみのをとはの里にうつ砧か南右深草や野となる里のしかすかにうつら衣をいまや打らん九番題欠左いかなれは山へのみみち色ふかき里はしくれのふらぬ物かは右秋山のもみちの色にうつろはぬひとのこゝろの花はあらしな十番庭残菊左春の夜の草木の花の色もかもにはにそ残る菊の一本右",
   "poems": [
    "13",
    "14",
    "15",
    "16",
    "17",
    "18",
    "19",
    "20"
   ]
  },
  {
   "id": "zoku-gunsho-teitoku-jikaawase-0004",
   "pid": "nao-733169",
   "pages": [
    4
   ],
   "text": "にほひつゝしほめる花もをく霜に色さへのこる庭のしら菊十一番逢増恋左いきぬへき心ちこそせぬ命にはかへらんといひて逢ぬ身なれは右くるしさはます田の池のねぬなはのねぬまそいまは恋しかりける十二番切待恋左とはゝ又いかにせよとてたましゐのまちいふる身をかれいつらん右待よはる露の身そうき契をかぬ草のはらをは猶もとはしを十三番久忍恋左いく秋の木々のははいろに出れともこはいはこの森のした露右今さらのおもひとやせん猶さらにいはしといひて年もへにけり十四番関路雲左治れるよにあふさかの関の戸はなれさへとちぬ山のはの雲右",
   "poems": [
    "21",
    "22",
    "23",
    "24",
    "25",
    "26",
    "27",
    "28"
   ]
  },
  {
   "id": "zoku-gunsho-teitoku-jikaawase-0005",
   "pid": "nao-733169",
   "pages": [
    5
   ],
   "text": "花の朝昼の夕もたゝこゝにおもこゝしらかはの関十五番壽日祝左万代のよはひはきみをはしめにてあまつひつきの末ひさしうれ右曇なくかはりなきよは久かたの光ならては何にたとへん右貞徳自歌合以尾崎雅喜本書寫畢",
   "poems": [
    "29",
    "30",
    "31"
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "君をなとおもふ色にはかへるらんうき世にそさぬすみそめのそて",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": ""
  },
  {
   "seq": "2",
   "text": "ほし合のそらやうらみむはつ秋の歌にひとくなゝくさの花",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "3",
   "text": "むしも又はたをりそめぬ秋野の老のにしきはたれかいそきし",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "4",
   "text": "人やかの道かとそおもふ時しもあれうき秋かせにわたるよりかね",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "5",
   "text": "故里やなをわすられぬ風さはきむらくもまうふ夜半のなか",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "6",
   "text": "山鳥のおきの葉そよくなかきよにひとりみしかき手枕の夢",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "7",
   "text": "手まくらの露に心や置ぬらんむすひかねたる長き夜の夢",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "8",
   "text": "遠山にしはしいさよふ月のうちのかつらのことき峯の松かえ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "9",
   "text": "雲はらぬ嵐をよはのあるしにておのへの松にやさる月影",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "",
   "dai": ""
  },
  {
   "seq": "10",
   "text": "古寺の明のつゝみもなかきよのふるみるや月の類にしるらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "11",
   "text": "ふるてらにもりいる月の愛もし火はあるゝにつきてかすそそひける",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "12",
   "text": "置ぬ歌をくや岡への竹の葉にそよかぬ月もそよく秋風",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "",
   "dai": ""
  },
  {
   "seq": "13",
   "text": "かたおかの月そさひし支さと人の夏はすゝみしさゝのゑのはら",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "14",
   "text": "朝日かけさせもか歌をいのちにてかきねの霜に残るむしのね",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "",
   "dai": ""
  },
  {
   "seq": "15",
   "text": "こなたかなま虫の鳴ねもかれ残る垣根やをのかたまのをまゝき",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "16",
   "text": "更行は雲ゐに高てなるかみのをとはの里にうつ砧か南",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "17",
   "text": "深草や野となる里のしかすかにうつら衣をいまや打らん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "18",
   "text": "いかなれは山へのみみち色ふかき里はしくれのふらぬ物かは",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "19",
   "text": "秋山のもみちの色にうつろはぬひとのこゝろの花はあらしな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "",
   "dai": ""
  },
  {
   "seq": "20",
   "text": "春の夜の草木の花の色もかもにはにそ残る菊の一本",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "21",
   "text": "にほひつゝしほめる花もをく霜に色さへのこる庭のしら菊",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "22",
   "text": "いきぬへき心ちこそせぬ命にはかへらんといひて逢ぬ身なれは",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "23",
   "text": "くるしさはます田の池のねぬなはのねぬまそいまは恋しかりける",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "24",
   "text": "とはゝ又いかにせよとてたましゐのまちいふる身をかれいつらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "25",
   "text": "待よはる露の身そうき契をかぬ草のはらをは猶もとはしを",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "26",
   "text": "いく秋の木々のははいろに出れともこはいはこの森のした露",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "27",
   "text": "今さらのおもひとやせん猶さらにいはしといひて年もへにけり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "28",
   "text": "治れるよにあふさかの関の戸はなれさへとちぬ山のはの雲",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "十四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "29",
   "text": "花の朝昼の夕もたゝこゝにおもこゝしらかはの関",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "十四",
   "side": "",
   "dai": ""
  },
  {
   "seq": "30",
   "text": "万代のよはひはきみをはしめにてあまつひつきの末ひさしうれ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "十五",
   "side": "",
   "dai": ""
  },
  {
   "seq": "31",
   "text": "曇なくかはりなきよは久かたのひかりならては何にたとへん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733169",
   "form": "短歌",
   "genre": "",
   "ban": "十五",
   "side": "右",
   "dai": ""
  }
 ],
